# Exemplo de variáveis de ambiente do IMobi.
# Copie para .env e ajuste. NUNCA commite o .env (ele está no .gitignore).
# Sem esses valores o servidor não sobe (não há senha hardcoded no código).

PGHOST=127.0.0.1
PGPORT=5432
PGUSER=imobi
PGPASSWORD=SUA_SENHA_AQUI
PGDATABASE=imobi

# Porta onde o servidor Node escuta
PORT=3000

# DSN de superusuário do Postgres, usado SÓ pelo db-init (reset do banco).
# Formato: postgres://USUARIO:SENHA@HOST:PORTA/POSTGRES
PGSUPER_DSN=postgres://postgres:SUA_SENHA_AQUI@127.0.0.1:5432/postgres
